<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalace programů" WindowState="Maximized" MinWidth="1000" MinHeight="640"
        Background="#E8EDEF" FontFamily="Segoe UI" FontSize="13.5" Foreground="#13232A"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0A6672"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#D8EDEF"/>
    <SolidColorBrush x:Key="Bg" Color="#E8EDEF"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F3F6F7"/>
    <SolidColorBrush x:Key="Line" Color="#D3DCDF"/>
    <SolidColorBrush x:Key="Line2" Color="#E5EAEC"/>
    <SolidColorBrush x:Key="Muted" Color="#56676E"/>
    <SolidColorBrush x:Key="HdBg" Color="#13232A"/>
    <SolidColorBrush x:Key="HdFg" Color="#DBE6E8"/>
    <SolidColorBrush x:Key="HdMuted" Color="#93A9AF"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#13232A"/>
      <Setter Property="BorderBrush" Value="#D3DCDF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#0A6672"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0A6672"/>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#0A6672"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style x:Key="HdBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#DBE6E8"/>
      <Setter Property="BorderBrush" Value="#3A4C53"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="Tab" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#93A9AF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,10,12,8">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#5CC6D1"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="White" Padding="10,5" BorderBrush="#D3DCDF" BorderThickness="1,1,0,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#0A6672"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- jedna horní lišta -->
    <Border Grid.Row="0" Background="{StaticResource HdBg}" Padding="16,4">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <Border Width="34" Height="34" CornerRadius="8" Background="#5CC6D1">
            <TextBlock Text="IP" FontWeight="Bold" FontSize="13" Foreground="#062A2F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Instalace programů" FontWeight="Bold" FontSize="15" Foreground="White"/>
            <TextBlock x:Name="HdSub" Text="" FontSize="11.5" Foreground="{StaticResource HdMuted}"/>
          </StackPanel>
        </StackPanel>
        <ToggleButton x:Name="TabStart" DockPanel.Dock="Left" Style="{StaticResource Tab}" Content="Úvodní kontrola" IsChecked="True"/>
        <ToggleButton x:Name="TabMain" DockPanel.Dock="Left" Style="{StaticResource Tab}" Content="Hlavní okno"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Stav · klikněte pro návod:" Foreground="{StaticResource HdMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <StackPanel x:Name="LedPanel" Orientation="Horizontal"/>
          <Button x:Name="BtnLang" Style="{StaticResource HdBtn}" Content="Jazyk uživatelů" Margin="12,0,0,0" ToolTip="Jazyk, klávesnice a formáty pro jednotlivé uživatele tohoto počítače"/>
          <Button x:Name="BtnNas" Style="{StaticResource HdBtn}" Content="Obsah NAS" Margin="6,0,0,0"/>
          <Button x:Name="BtnManual" Style="{StaticResource HdBtn}" BorderThickness="0" Foreground="#93A9AF" Content="O instalátoru" Margin="4,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 1) úvodní kontrola -->
    <ScrollViewer x:Name="PageStart" Grid.Row="1">
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
              MaxWidth="900" Margin="20,32,20,40" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel Margin="26,22,26,16">
            <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource Accent}" DockPanel.Dock="Left">
              <TextBlock Text="IP" FontWeight="Bold" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Instalace programů" FontSize="22" FontWeight="Bold"/>
              <TextBlock x:Name="StartSub" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </DockPanel>
          <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,1,0,0"/>
          <StackPanel x:Name="CheckList"/>
          <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="26,16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRecheck" Style="{StaticResource Btn}" Content="Zkontrolovat znovu" Margin="0,0,10,0"/>
                <Button x:Name="BtnGo" Style="{StaticResource Primary}" Content="Pokračovat"/>
              </StackPanel>
              <TextBlock x:Name="StartMsg" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- 2) hlavní okno: 1 balíčky | 2 vybrané | 3 přidat/odebrat -->
    <Grid x:Name="PageMain" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,10">
            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Balíčky" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="WhoText" DockPanel.Dock="Bottom" Margin="16,10,16,16" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
          <ScrollViewer><StackPanel x:Name="BundleList" Margin="14,0,14,10"/></ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
          <DockPanel>
            <Button x:Name="BtnClear" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="10,4" Content="Zrušit vše" ToolTip="Odebere všechny programy kromě povinných" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="MidTitle" Text="Vybrané programy" FontWeight="Bold" FontSize="15" Margin="10,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="MidCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,24,0"/>
              <StackPanel x:Name="ModePanel" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Instalovat pro" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="RbRec" Style="{StaticResource Seg}" GroupName="mode" Content="Podle doporučení" IsChecked="True"/>
                <RadioButton x:Name="RbAll" Style="{StaticResource Seg}" GroupName="mode" Content="Všichni uživatelé"/>
                <RadioButton x:Name="RbUser" Style="{StaticResource Seg}" GroupName="mode" Content="Jen uživatel" BorderThickness="1"/>
                <Border Width="1" Background="#D3DCDF"/>
                <Ellipse Width="7" Height="7" Fill="#1B7443" Margin="10,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="doporučeno" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="SelScroll" Grid.Row="1"><StackPanel x:Name="SelList" Margin="20,8,20,24"/></ScrollViewer>
        <Grid x:Name="RunPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <Border x:Name="SummaryBox" CornerRadius="10" Padding="14" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel x:Name="SummaryPanel"/></Border>
            <TextBlock x:Name="ProgText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
            <ProgressBar x:Name="Prog" Height="8" Foreground="{StaticResource Accent}" Background="#F3F6F7" BorderThickness="0" Margin="0,0,0,12"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1"><StackPanel><StackPanel x:Name="ProbList"/><StackPanel x:Name="RunList"/></StackPanel></ScrollViewer>
          <Expander Grid.Row="2" Header="Podrobný log" Margin="0,10,0,0">
            <TextBox x:Name="LogBox" Height="180" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F3F6F7" BorderBrush="#E5EAEC"/>
          </Expander>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnLog" Style="{StaticResource Link}" Content="Otevřít log" Margin="0,0,10,0" Visibility="Collapsed"/>
              <Button x:Name="BtnCancel" Style="{StaticResource Btn}" Content="Zastavit po aktuální položce" Visibility="Collapsed" Margin="0,0,10,0"/>
              <Button x:Name="BtnNew" Style="{StaticResource Btn}" Content="Nová instalace" Visibility="Collapsed" Margin="0,0,10,0"/>
              <Button x:Name="BtnInstall" Style="{StaticResource Primary}" Padding="20,10" FontSize="14.5" Content="Instalovat vybrané"/>
            </StackPanel>
            <TextBlock x:Name="SumText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,14,16,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Přidat nebo odebrat" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Margin="0,0,0,8">
              <TextBox x:Name="TxtSearch" Padding="8,6" BorderBrush="#D3DCDF" Background="#F3F6F7"/>
              <TextBlock x:Name="SearchHint" Text="Hledat program" Foreground="#8A989E" Margin="11,7,0,0" IsHitTestVisible="False"/>
            </Grid>
            <DockPanel>
              <CheckBox x:Name="ChkMissing" DockPanel.Dock="Right" Content="Jen nenainstalované" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <ComboBox x:Name="CmbCat" Padding="6,5"/>
            </DockPanel>
            <TextBlock x:Name="BusyNote" Text="Během instalace nelze výběr měnit." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"/>
          <ScrollViewer x:Name="CatScroll"><StackPanel x:Name="CatList" Margin="12,4,12,20"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- oznámení -->
    <Border x:Name="Toast" Grid.Row="1" Background="#13232A" CornerRadius="10" Padding="16,12" Margin="20" MaxWidth="520"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
      <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
